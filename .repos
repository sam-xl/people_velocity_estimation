repositories:
  # people_msgs — the interface this node publishes on, and what nav2's social
  # costmap layer consumes.
  people:
    type: git
    url: https://github.com/wg-perception/people.git
    version: 0ae47f6e0208cedd84d19d066743fdc1d05fcafa  # ros2 at 21-08-2026

  # riskam_msgs — the PersonDetections interface this node consumes.
  risk-awareness-module:
    type: git
    url: https://github.com/sam-xl/risk-awareness-module.git
    version: velocity_estimator

  # Test fixtures, and the topic helpers the node tests use.
  ros2_test_utils:
    type: git
    url: https://github.com/sam-xl/ros2_test_utils.git
    version: feat/add-topic-support  # main once sam-xl/ros2_test_utils merges it
