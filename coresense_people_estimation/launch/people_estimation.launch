<?xml version="1.0"?>
<!--
  Bring up the people_estimation node.

  Turns riskam_msgs/PersonDetections into people_msgs/People, in the colour
  optical frame. The node name must stay "people_estimation":
  config/people_estimation.yml keys its parameters on the fully-qualified node
  name, and renaming either side silently stops them from being applied.
-->
<launch>
  <arg name="config"
       default="$(find-pkg-share coresense_people_estimation)/config/people_estimation.yml"
       description="Parameter file for the people_estimation node."/>
  <arg name="debug" default="false"
       description="Publish debug markers and per-person TF frames. This always overrides the `debug'; key in the parameter file."/>

  <!-- The debug override comes after the file so it wins. -->
  <node pkg="coresense_people_estimation" exec="people_estimation_node"
        name="people_estimation" output="screen">
    <param from="$(var config)"/>
    <param name="debug" value="$(var debug)" type="bool"/>
  </node>
</launch>
