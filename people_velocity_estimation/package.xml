<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>people_velocity_estimation</name>
  <version>0.0.1</version>
  <description>
    Turns riskam_msgs/PersonDetections into people_msgs/People: samples depth
    under each detection, back-projects it through the camera model, and fits a
    per-track velocity over a short history. The result is re-framed into a
    world-fixed frame through TF and compensated for the robot's own motion, so
    what is published is world-fixed rather than robot-relative.
  </description>
  <maintainer email="G.Sotirchos@tudelft.nl">George Sotirchos</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>image_geometry</depend>
  <depend>message_filters</depend>
  <depend>people_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>riskam_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <!-- scripts/dummy_tf.py and scripts/bag_camera_shim.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
